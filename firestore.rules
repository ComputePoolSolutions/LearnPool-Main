rules_version = '2';
// LearnPool talks to Firestore only through the backend (Admin SDK, which bypasses
// these rules). Deny every direct client access.
// Roles and passwords are never writable from a browser: roles live in the users collection and only an
// administrator can change them through the backend; passwords live in Firebase Authentication.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
