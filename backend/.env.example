# Required
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Optional SMTP for email verification and course updates
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=LearnPool <no-reply@example.com>

# Firebase / Firestore (choose ONE way to provide credentials)
# 1) Put the downloaded service-account key at backend/serviceAccountKey.json (default), or point to it:
FIREBASE_SERVICE_ACCOUNT_PATH=
# 2) Or paste the key JSON (or its base64) here, handy for hosting providers:
FIREBASE_SERVICE_ACCOUNT_JSON=
# 3) Or use the three individual values from the key file:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Local emulator (optional): FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ---- Which email addresses may be students or instructors ---------------------
# * = any valid email address (default). Or list the allowed domains, e.g. @college.edu,@gmail.com
ALLOWED_EMAIL_DOMAINS=*
# Optional: let a first sign-in create a Student account when the password is the email username,
# but ONLY for the domains you list (comma-separated). Leave this commented out to keep it off.
# AUTO_PROVISION_DOMAINS=@yourcollege.edu

# ---- Passwords ---------------------------------------------------------------
# Where permanent passwords are stored and checked:
#   firebase = Firebase Authentication (recommended; no password or hash is kept in Firestore)
#   local    = a bcrypt hash on the user's Firestore document
#   auto     = firebase as soon as FIREBASE_WEB_API_KEY is set, otherwise local
AUTH_PROVIDER=auto
# Firebase console -> Project settings -> General -> "Web API Key". Needed so the backend can check
# passwords with Firebase Authentication. (Also enable Authentication -> Sign-in method -> Email/Password.)
FIREBASE_WEB_API_KEY=
# Local Auth emulator (optional): FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---- Demo login (testing only; always off when NODE_ENV=production) ------------
# true = onboarding access: any valid email and any password opens a NEW student account, or an existing
# account that has not set a permanent password yet. Once a permanent password is set, it is required.
# Restart the backend after changing this file.
DEMO_LOGIN_MODE=true
# Instructors also sign in with any password in demo mode (admins never can). Default: on.
# Set to false to make instructors use their real password.
DEMO_ALLOW_INSTRUCTORS=true
# Keep false: administrator accounts always need their real password.
DEMO_ALLOW_PRIVILEGED_ACCOUNTS=false

# Base address used in certificate verification links
PUBLIC_APP_URL=http://localhost:5173

# Optional: enables the AI tutor chatbot (Google Gemini). Without it the chatbot asks for the key.
GEMINI_API_KEY=
