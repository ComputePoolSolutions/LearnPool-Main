# Required
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Optional SMTP for email verification and course updates
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=LearnPool <no-reply@example.com>

# Firebase / Firestore (choose ONE way to provide credentials)
# 1) Put the downloaded service-account key at backend/serviceAccountKey.json (default), or point to it:
FIREBASE_SERVICE_ACCOUNT_PATH=
# 2) Or paste the key JSON (or its base64) here, handy for hosting providers:
FIREBASE_SERVICE_ACCOUNT_JSON=
# 3) Or use the three individual values from the key file:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Local emulator (optional): FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ---- Which email addresses may be students or instructors ---------------------
# * = any valid email address (default). Or list the allowed domains, e.g. @mlrit.ac.in,@gmail.com
ALLOWED_EMAIL_DOMAINS=*
# On first sign-in, a student account is created automatically when the password is the email
# username, but ONLY for these domains (comma-separated). Set AUTO_PROVISION_STUDENTS=false to turn off.
AUTO_PROVISION_STUDENTS=true
AUTO_PROVISION_DOMAINS=@mlrit.ac.in

# ---- Demo login (testing only; always off when NODE_ENV=production) ------------
# true = any valid email and any non-empty password signs in. New emails become Students.
# Existing accounts keep their real role. Restart the backend after changing this file.
DEMO_LOGIN_MODE=true
# Instructors may also sign in with any password in demo mode (admins never can).
DEMO_ALLOW_INSTRUCTORS=true
# Keep false: administrator accounts always need their real password.
DEMO_ALLOW_PRIVILEGED_ACCOUNTS=false

# Base address used in certificate verification links
PUBLIC_APP_URL=http://localhost:5173
